---
/**
 * Multiple-choice quiz for one topic (Themen).
 *
 * The whole point is recall: you are shown a word and have to pick its
 * translation from four options, so the word list is deliberately NOT on
 * screen while you play. Every word of the topic becomes exactly one
 * question, in random order, and the quiz ends by itself once the queue is
 * empty — there is no fixed round length to configure.
 *
 * The word pool is computed at build time and handed to the client as JSON, so
 * the page ships no data request and works offline.
 *
 * Layout of a question, top to bottom: the word in its own box, then the four
 * options, then one button that is both the verdict and the way on.
 *
 * There is no separate feedback line: the Continue button sits under the
 * options disabled until an answer is picked, and picking one turns it green
 * or red and writes the verdict on it, so reading the answer and moving on are
 * the same press.
 *
 * The direction (German to English or back) is chosen on the topic page and
 * arrives here as ?mode=…, so this page has no setup screen: it starts on
 * load, and "Try again" reshuffles the same direction.
 */
import Icon from "./Icon.astro";
import AudioButton from "./AudioButton.astro";
import { audioPath } from "../lib/audio";

interface Word {
  de: string;
  en: string;
  art?: string;
  level?: string;
  hex?: string;
}
interface Group {
  id: string;
  title: string;
  en?: string;
  words: Word[];
}
interface Props {
  slug: string;
  theme: {
    title: string;
    subtitle: string;
    tint: string;
    icon: string;
    groups: Group[];
  };
}

const { slug, theme } = Astro.props;

// One flat pool of { de, en }: the groups only organise the reading page, the
// quiz draws from the topic as a whole.
const pool = theme.groups.flatMap((g) =>
  g.words.map((w) => ({ de: w.de, en: w.en, a: audioPath(w.de) })),
);

// The article is part of `de` already ("die Katze"), which is exactly what we
// want in both directions.
const data = JSON.stringify({ slug, title: theme.title, words: pool }).replace(/</g, "\\u003c");
const enough = pool.length >= 4;
---

<div class="theme-quiz" style={`--tq-tint:${theme.tint}`}>
  <script type="application/json" class="tq-data" set:html={data} />

  <!-- ── Question screen ──────────────────────────────────────────────── -->
  <section id="tq-play" class="tq-screen" hidden>
    <div class="tq-bar-wrap" role="progressbar" aria-label="Progress">
      <div id="tq-bar" class="tq-bar"></div>
    </div>
    <span id="tq-live" class="tq-sr" aria-live="polite"></span>

    <div class="tq-qbox">
      <div id="tq-word" class="tq-word">…</div>
      <div class="tq-audio-wrap"><AudioButton text="" variant="md" class="tq-audio" /></div>
    </div>

    <div id="tq-opts" class="tq-opts" role="group" aria-label="Answer choices"></div>

    <button type="button" id="tq-next" class="btn btn-primary tq-next" disabled>Continue</button>
  </section>

  <!-- ── Result screen ────────────────────────────────────────────────── -->
  <section id="tq-result" class="tq-screen" hidden>
    <div class="card tq-panel tq-result">
      <div class="tq-trophy"><Icon name="trophy" size={40} style={`color:${theme.tint}`} /></div>
      <p class="tq-rlabel">Quiz Result</p>
      <p id="tq-rtotal" class="tq-rtotal">0 / 0</p>
      <p id="tq-rpct" class="tq-rpct">0%</p>

      <div id="tq-rwrong" class="tq-rwrong" hidden>
        <h3 class="tq-rh3">To review</h3>
        <ul id="tq-rlist" class="tq-rlist"></ul>
      </div>

      <div class="tq-actions">
        <button type="button" id="tq-again" class="btn btn-secondary">Try again</button>
        <a href={`/themes/${slug}/`} class="btn btn-ghost">Back to topic</a>
      </div>
    </div>
  </section>

  <!-- ── Leave confirmation: shown when a link away is clicked mid-quiz. ── -->
  <div id="tq-confirm" class="tq-modal" hidden>
    <div
      class="tq-modal-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tq-confirm-title"
      aria-describedby="tq-confirm-text"
    >
      <h2 id="tq-confirm-title" class="tq-modal-title">Leave the quiz?</h2>
      <p id="tq-confirm-text" class="tq-modal-text">Your progress will be lost.</p>
      <div class="tq-modal-actions">
        <button type="button" id="tq-confirm-stay" class="btn btn-primary">Keep going</button>
        <button type="button" id="tq-confirm-leave" class="btn btn-ghost">Leave</button>
      </div>
    </div>
  </div>

  <!-- ── Fallback: a topic too small to quiz (never true today, kept so the
         page still says something sensible if one ever is). ─────────────── -->
  {
    !enough && (
      <div class="card tq-panel">
        <p class="tq-warn">This topic does not have enough words for a quiz yet.</p>
        <a href={`/themes/${slug}/`} class="btn btn-ghost tq-begin">
          Back to topic
        </a>
      </div>
    )
  }
</div>

<style is:global>
  .theme-quiz {
    /* One value drives the gap under the progress bar and the gap above the
       verdict/continue button, so the question reads top and bottom symmetrically
       and the two can never drift apart in a later edit. */
    --tq-edge-gap: 1.1rem;
    --tq-ok: var(--color-feather);
    --tq-ok-edge: var(--color-feather-shadow);
    --tq-no: var(--color-cardinal);
    --tq-no-edge: var(--color-cardinal-shadow);
  }

  .theme-quiz .tq-screen[hidden] {
    display: none;
  }

  /* Screen-reader-only: the verdict is also announced from here, since a live
     region cannot be attached to the colour change on the button itself. */
  .tq-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .tq-panel {
    padding: 1.4rem;
  }

  .tq-begin {
    width: 100%;
    justify-content: center;
    text-transform: none;
    letter-spacing: 0;
    margin-top: 1rem;
  }

  .tq-warn {
    color: var(--text-muted);
    margin: 0;
  }

  /* ── play ── */
  .tq-bar-wrap {
    /* Same thickness as the Learn page's progress bar, with its inner shine. */
    height: 16px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
    position: relative;
    /* The bar gets more room under it than the question uses between its own
       parts (0.7rem), so it reads as page furniture rather than as the first
       line of the question; the page header above is trimmed to the same value
       on this page, so the bar sits in an evenly spaced stack. The bottom gap
       is the same token the button uses above it, so the two match exactly. */
    margin-bottom: var(--tq-edge-gap);
  }
  .tq-bar {
    height: 100%;
    width: 0;
    background: var(--tq-tint, var(--color-macaw));
    border-radius: 999px;
    position: relative;
    transition: width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tq-bar::after {
    content: "";
    position: absolute;
    inset: 4px 6px auto 6px;
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
  }

  /* The prompt sits in its own box at the top of the question, so it reads as
     the thing being asked rather than as a floating word. Its bottom gap is
     the same 0.7rem the options use between each other, so the whole question
     reads as one evenly spaced stack. */
  .tq-qbox {
    border: 2px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    padding: 1.4rem 3.4rem;
    margin-bottom: 0.7rem;
    position: relative;
  }

  /* Speaker pinned to the right edge of the question box. Wrapped in its own
     absolutely-positioned div so the button's own :active transform stays local. */
  .tq-audio-wrap {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .tq-audio-wrap[hidden] {
    display: none;
  }

  .tq-word {
    text-align: center;
    font-weight: 900;
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    line-height: 1.15;
    color: var(--text-strong);
    word-break: break-word;
  }

  /* The grid spans the same width as the question box above it, so the two
     blocks line up edge to edge. */
  .tq-opts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }

  /* Options are rectangles at every width: the grid spans the same width as
     the question box, and each option is a little taller than its text so the
     tap target stays comfortable. */
  .tq-opt {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    /* Same height on every screen: a 7rem box is a comfortable tap target on a
       phone too, and keeping one value means the four answers sit the same way
       whether the question is read on a laptop or a handset. */
    min-height: 7rem;
    padding: 1.1rem 1rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-strong);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease, transform 0.06s ease;
  }
  .tq-opt:hover:not(.is-locked) {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .tq-opt:active:not(.is-locked) {
    transform: translateY(2px);
  }
  .tq-txt {
    min-width: 0;
  }
  .tq-opt.is-locked {
    cursor: default;
  }
  .tq-opt.is-correct {
    border-color: var(--tq-ok);
    background: color-mix(in srgb, var(--tq-ok) 16%, transparent);
    color: var(--text-strong);
  }
  .tq-opt.is-wrong {
    border-color: var(--tq-no);
    background: color-mix(in srgb, var(--tq-no) 14%, transparent);
  }

  /* The verdict and the way on are one control. It rests below the options in
     the primary green, disabled; answering turns it into the verdict and
     enables it, so the press that reads "Correct!" is the press that moves to
     the next question. */
  .tq-next {
    display: flex;
    width: 100%;
    margin-top: var(--tq-edge-gap);
    padding: 0.9rem 1.25rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .tq-next.is-ok {
    background: var(--tq-ok);
    border-bottom-color: var(--tq-ok-edge);
  }
  .tq-next.is-no {
    background: var(--tq-no);
    border-bottom-color: var(--tq-no-edge);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tq-next.is-ok,
    .tq-next.is-no {
      animation: tq-pop 0.18s ease;
    }
  }
  @keyframes tq-pop {
    from {
      transform: scale(0.97);
    }
    to {
      transform: scale(1);
    }
  }

  /* ── result ── */
  .tq-result {
    text-align: center;
  }
  .tq-trophy {
    display: flex;
    justify-content: center;
    margin-bottom: 0.4rem;
  }
  .tq-rlabel {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin: 0;
  }
  .tq-rtotal {
    font-size: clamp(2.2rem, 9vw, 3.2rem);
    font-weight: 900;
    color: var(--text-strong);
    margin: 0.2rem 0 0;
    font-variant-numeric: tabular-nums;
  }
  .tq-rpct {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-muted);
    margin: 0 0 1.4rem;
  }
  .tq-rwrong {
    text-align: left;
    border-top: 2px solid var(--border);
    padding-top: 1rem;
    margin-bottom: 1.4rem;
  }
  .tq-rh3 {
    font-size: 0.95rem;
    margin: 0 0 0.6rem;
  }
  .tq-rlist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .tq-rrow {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.9rem;
    padding: 0.45rem 0.6rem;
    border-radius: 10px;
    background: var(--surface-2);
  }
  .tq-rp {
    font-weight: 800;
    color: var(--text-muted);
  }
  .tq-rp::after {
    content: "→";
    margin-left: 0.4rem;
    color: var(--text-faint);
  }
  .tq-ra {
    font-weight: 900;
    color: var(--tq-ok);
  }
  .tq-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .tq-actions .btn {
    text-transform: none;
    letter-spacing: 0;
  }

  /* ── leave confirmation ── */
  .tq-modal[hidden] {
    display: none;
  }
  .tq-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: color-mix(in srgb, #000 60%, transparent);
    backdrop-filter: blur(4px);
  }
  .tq-modal-card {
    width: 100%;
    max-width: 22rem;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1.4rem;
    text-align: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }
  .tq-modal-title {
    font-size: 1.25rem;
    margin: 0 0 0.4rem;
    color: var(--text-strong);
  }
  .tq-modal-text {
    margin: 0 0 1.2rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .tq-modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .tq-modal-actions .btn {
    text-transform: none;
    letter-spacing: 0;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector(".theme-quiz");
    if (!root) return;
    var dataEl = root.querySelector(".tq-data");
    if (!dataEl) return;

    var DATA;
    try {
      DATA = JSON.parse(dataEl.textContent);
    } catch (e) {
      return;
    }
    var WORDS = (DATA && DATA.words) || [];
    if (WORDS.length < 4) return;

    var q = function (sel) {
      return root.querySelector(sel);
    };
    var playEl = q("#tq-play");
    var resultEl = q("#tq-result");
    var barEl = q("#tq-bar");
    var wordEl = q("#tq-word");
    var ttsWrap = q(".tq-audio-wrap");
    var optsEl = q("#tq-opts");
    var liveEl = q("#tq-live");
    var nextBtn = q("#tq-next");
    var againBtn = q("#tq-again");
    var modalEl = q("#tq-confirm");
    var stayBtn = q("#tq-confirm-stay");
    var leaveBtn = q("#tq-confirm-leave");

    // The direction is chosen on the topic page and arrives as ?mode=en-de;
    // German to English is the default when the page is opened directly.
    var params = new URLSearchParams(window.location.search);
    var mode = params.get("mode") === "en-de" ? "en-de" : "de-en";

    var queue = [];
    var pos = 0;
    var right = 0;
    var wrong = 0;
    var wrongList = [];
    var locked = false;
    // True once the result screen is up: leaving is then free, no confirmation.
    var finished = false;
    // The link the user tried to follow, held while the dialog is open.
    var pendingHref = null;

    function shuffle(a) {
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = a[i];
        a[i] = a[j];
        a[j] = t;
      }
      return a;
    }

    function promptOf(w) {
      return mode === "de-en" ? w.de : w.en;
    }
    function answerOf(w) {
      return mode === "de-en" ? w.en : w.de;
    }

    // Three distractors drawn from the topic itself. A word that shares the
    // prompt's meaning is skipped so no distractor is also a valid answer, and
    // identical option texts are collapsed.
    function buildOptions(w) {
      var correct = answerOf(w);
      var seen = {};
      seen[correct] = true;
      var cands = [];
      for (var i = 0; i < WORDS.length; i++) {
        var o = WORDS[i];
        if (o === w) continue;
        if (o.en === w.en) continue;
        var txt = answerOf(o);
        if (seen[txt]) continue;
        seen[txt] = true;
        cands.push(txt);
      }
      cands = shuffle(cands).slice(0, 3);
      return shuffle(cands.concat([correct]));
    }

    function show(screen) {
      playEl.hidden = screen !== playEl;
      resultEl.hidden = screen !== resultEl;
      if (screen !== playEl) window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function renderQuestion() {
      var w = queue[pos];
      locked = false;
      liveEl.textContent = "";
      // The button goes back to resting: green, disabled, asking for an answer.
      nextBtn.className = "btn btn-primary tq-next";
      nextBtn.disabled = true;
      nextBtn.textContent = "Continue";
      barEl.style.width = (pos / queue.length) * 100 + "%";
      wordEl.textContent = promptOf(w);

      // Pronunciation belongs to the German side only, so it is wired to `w.de`
      // (which already carries the article) and hidden when the prompt is English.
      if (ttsWrap) {
        var ttsSrc = mode === "de-en" ? w.a || "" : "";
        var ttsBtn = ttsWrap.querySelector("button");
        if (ttsBtn) {
          ttsBtn.setAttribute("data-audio", ttsSrc);
          var ttsLabel = ttsSrc ? "Dengar pelafalan: " + w.de : "Dengar pelafalan";
          ttsBtn.setAttribute("aria-label", ttsLabel);
          ttsBtn.setAttribute("title", ttsLabel);
        }
        ttsWrap.hidden = !ttsSrc;
      }

      var opts = buildOptions(w);
      optsEl.innerHTML = "";
      opts.forEach(function (txt) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "tq-opt";
        var s = document.createElement("span");
        s.className = "tq-txt";
        s.textContent = txt;
        b.appendChild(s);
        b.addEventListener("click", function () {
          choose(b, txt, w);
        });
        optsEl.appendChild(b);
      });
    }

    // Two short German clips for the verdict. Built lazily so a visitor who
    // never answers a question never downloads them.
    var sfx = null;
    function playSfx(ok) {
      try {
        if (!sfx) {
          sfx = { ok: new Audio("/sfx/correct.mp3"), no: new Audio("/sfx/wrong.mp3") };
        }
        var a = ok ? sfx.ok : sfx.no;
        a.currentTime = 0;
        var p = a.play();
        if (p && p.catch) p.catch(function () {});
      } catch (e) {}
    }

    function choose(btn, txt, w) {
      if (locked) return;
      locked = true;
      var correct = answerOf(w);
      var isRight = txt === correct;

      // Fired from the click handler, so the browser counts it as a user gesture
      // and does not block playback.
      playSfx(isRight);

      var all = Array.prototype.slice.call(optsEl.querySelectorAll(".tq-opt"));
      all.forEach(function (b) {
        b.classList.add("is-locked");
        var t = b.querySelector(".tq-txt").textContent;
        if (t === correct) b.classList.add("is-correct");
        else if (b === btn) b.classList.add("is-wrong");
      });

      var msg;
      if (isRight) {
        right++;
        msg = "Correct!";
        nextBtn.className = "btn btn-primary tq-next is-ok";
      } else {
        wrong++;
        wrongList.push({ prompt: promptOf(w), correct: correct });
        msg = "Wrong — the answer is: " + correct;
        nextBtn.className = "btn btn-primary tq-next is-no";
      }

      nextBtn.textContent = msg;
      liveEl.textContent = msg;
      nextBtn.disabled = false;

      barEl.style.width = ((pos + 1) / queue.length) * 100 + "%";
      // Focus follows the button, so Enter carries on to the next question
      // instead of re-firing the option that still holds focus.
      nextBtn.focus();
    }

    function next() {
      if (!locked) return;
      pos++;
      if (pos >= queue.length) showResult();
      else renderQuestion();
    }

    function showResult() {
      finished = true;
      show(resultEl);
      var total = queue.length;
      var pct = total ? Math.round((right / total) * 100) : 0;
      q("#tq-rtotal").textContent = right + " / " + total;
      q("#tq-rpct").textContent = pct + "% correct";

      var wrapEl = q("#tq-rwrong");
      var listEl = q("#tq-rlist");
      listEl.innerHTML = "";
      if (wrongList.length) {
        wrapEl.hidden = false;
        wrongList.forEach(function (it) {
          var li = document.createElement("li");
          li.className = "tq-rrow";
          var p = document.createElement("span");
          p.className = "tq-rp";
          p.textContent = it.prompt;
          var a = document.createElement("span");
          a.className = "tq-ra";
          a.textContent = it.correct;
          li.appendChild(p);
          li.appendChild(a);
          listEl.appendChild(li);
        });
      } else {
        wrapEl.hidden = true;
      }
    }

    function start() {
      queue = shuffle(WORDS.slice());
      pos = 0;
      right = 0;
      wrong = 0;
      wrongList = [];
      finished = false;
      show(playEl);
      renderQuestion();
    }

    // ── Leaving mid-quiz ──────────────────────────────────────────────────
    // While a round is in progress, following any internal link (the bottom
    // nav, "Back to topic", the browser back button) asks first, so a stray
    // tap does not silently throw the round away.
    function inProgress() {
      return !finished && !playEl.hidden;
    }
    function openConfirm(href) {
      pendingHref = href;
      modalEl.hidden = false;
      stayBtn.focus();
    }
    function closeConfirm() {
      modalEl.hidden = true;
      pendingHref = null;
    }

    stayBtn.addEventListener("click", closeConfirm);
    leaveBtn.addEventListener("click", function () {
      var href = pendingHref;
      closeConfirm();
      finished = true;
      if (href) window.location.href = href;
    });
    modalEl.addEventListener("click", function (e) {
      if (e.target === modalEl) closeConfirm();
    });
    document.addEventListener("keydown", function (e) {
      if (modalEl.hidden) return;
      if (e.key === "Escape") {
        e.preventDefault();
        closeConfirm();
      }
    });

    // Intercept clicks on same-page links (capture phase, so it wins over any
    // handler further down) and hold them back until the user confirms.
    document.addEventListener(
      "click",
      function (e) {
        if (!inProgress()) return;
        var a = e.target.closest ? e.target.closest("a[href]") : null;
        if (!a) return;
        var href = a.getAttribute("href");
        if (!href || href.charAt(0) === "#") return;
        if (a.target === "_blank" || a.hasAttribute("download")) return;
        // Same-origin navigation only; anything external is left alone.
        if (a.origin && a.origin !== window.location.origin) return;
        e.preventDefault();
        e.stopPropagation();
        openConfirm(a.href);
      },
      true
    );

    // Back button, reload or closing the tab mid-round: the browser's own
    // prompt, since a script cannot style or veto those navigations.
    window.addEventListener("beforeunload", function (e) {
      if (inProgress() && modalEl.hidden) {
        e.preventDefault();
        e.returnValue = "";
        return "";
      }
    });

    // The quiz starts as soon as the page opens: the direction was already
    // chosen on the topic page, so there is no start screen left to wait on.
    nextBtn.addEventListener("click", next);
    againBtn.addEventListener("click", function () {
      start();
    });
    // Keyboard: 1–4 picks an option, Enter/Space moves on. The button is live
    // only once an answer is in, and preventDefault stops Enter/Space from also
    // re-activating whatever option still holds focus.
    document.addEventListener("keydown", function (e) {
      if (playEl.hidden || !modalEl.hidden) return;
      if (e.key === "Enter" || e.key === " ") {
        if (!nextBtn.disabled) {
          e.preventDefault();
          next();
        }
        return;
      }
      if (!locked && e.key >= "1" && e.key <= "4") {
        var b = optsEl.querySelectorAll(".tq-opt")[Number(e.key) - 1];
        if (b) b.click();
      }
    });

    start();
  })();
</script>
