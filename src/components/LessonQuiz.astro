---
/**
 * Lesson Check — a three-stage quiz for one lesson.
 *
 * Stage 1 vocabulary (de → en), stage 2 grammar (fill-in-the-blank from the
 * lesson's own exercises), stage 3 listening (audio → German word).
 *
 * Data comes from src/data/lesson-quiz.json, generated by
 * scripts/build-lesson-quiz.py. Everything is static: no backend, no network.
 *
 * The verdict tones and the word audio are played by handlers that already exist
 * globally — /sfx/*.mp3 by this component, /audio/*.mp3 by BaseLayout's delegated
 * click handler (the speaker buttons carry data-audio).
 */
import { audioPath } from "../lib/audio";

interface Props {
  quiz: {
    level: string;
    slug: string;
    title: string;
    vocab: { de: string; en: string }[];
    grammar: {
      kind: string;
      block: string;
      prompt: string;
      answer: string;
      distractors: string[];
    }[];
  };
}

const { quiz } = Astro.props;

// Send only what the runtime needs, and shrink it: the full lesson file carries
// a lot more than one quiz session uses.
const payload = JSON.stringify({
  vocab: quiz.vocab.map((w) => ({ de: w.de, en: w.en, a: audioPath(w.de) })),
  grammar: quiz.grammar.map((g) => ({
    kind: g.kind,
    prompt: g.prompt,
    answer: g.answer,
    wrong: g.distractors,
  })),
}).replace(/</g, "\\u003c");

const VOCAB_N = Math.min(6, quiz.vocab.length);
const GRAMMAR_N = Math.min(6, quiz.grammar.length);
const LISTEN_N = Math.min(4, quiz.vocab.length);
const TOTAL = VOCAB_N + GRAMMAR_N + LISTEN_N;
---

<div class="lq" data-lq>
  <script type="application/json" class="lq-data" set:html={payload} />

  <!-- Start -->
  <section class="lq-screen" data-screen="start">
    <div class="card lq-start">
      <ul class="lq-plan">
        <li><span class="lq-num">{VOCAB_N}</span> Vocabulary — pilih arti kata</li>
        <li><span class="lq-num">{GRAMMAR_N}</span> Grammar — isi bagian rumpang</li>
        <li><span class="lq-num">{LISTEN_N}</span> Listening — dengar lalu pilih kata</li>
      </ul>
      <p class="lq-meta">{TOTAL} soal · kata dan kalimat diambil dari lesson ini</p>
      <button type="button" class="btn btn-primary" data-start style="width:100%">Mulai</button>
    </div>
  </section>

  <!-- Play -->
  <section class="lq-screen" data-screen="play" hidden>
    <div class="lq-bar-wrap" role="progressbar" aria-label="Progress">
      <div class="lq-bar" data-bar></div>
    </div>
    <p class="lq-stage" data-stage></p>

    <div class="card lq-qbox">
      <div class="lq-prompt" data-prompt></div>
      <div class="lq-speaker" data-speaker hidden></div>
    </div>

    <div class="lq-opts" data-opts role="group" aria-label="Pilihan jawaban"></div>
    <button type="button" class="btn btn-primary" data-next disabled style="width:100%">Lanjut</button>
    <span class="lq-sr" data-live aria-live="polite"></span>
  </section>

  <!-- Result -->
  <section class="lq-screen" data-screen="result" hidden>
    <div class="card lq-result">
      <p class="lq-kicker">Hasil</p>
      <p class="lq-score" data-score>0 / 0</p>
      <ul class="lq-breakdown" data-breakdown></ul>
      <button type="button" class="btn btn-primary" data-again style="width:100%">Coba lagi</button>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector("[data-lq]");
  if (root) {
    const data = JSON.parse((root.querySelector(".lq-data") as HTMLElement).textContent || "{}");
    const q = (sel: string) => root.querySelector(sel) as HTMLElement | null;
    const screens = {
      start: q('[data-screen="start"]')!,
      play: q('[data-screen="play"]')!,
      result: q('[data-screen="result"]')!,
    };
    const barEl = q("[data-bar]")!;
    const stageEl = q("[data-stage]")!;
    const promptEl = q("[data-prompt]")!;
    const speakerEl = q("[data-speaker]")!;
    const optsEl = q("[data-opts]")!;
    const nextBtn = q("[data-next]") as HTMLButtonElement;
    const liveEl = q("[data-live]")!;
    const scoreEl = q("[data-score]")!;
    const breakdownEl = q("[data-breakdown]")!;

    const VOCAB_N = Math.min(6, data.vocab.length);
    const GRAMMAR_N = Math.min(6, data.grammar.length);
    const LISTEN_N = Math.min(4, data.vocab.length);

    let queue: any[] = [];
    let pos = 0;
    let locked = false;
    let scores = { vocab: 0, grammar: 0, listen: 0 };
    let totals = { vocab: VOCAB_N, grammar: GRAMMAR_N, listen: LISTEN_N };

    const sfx = { ok: null as HTMLAudioElement | null, no: null as HTMLAudioElement | null };
    function playSfx(ok: boolean) {
      try {
        if (!sfx.ok) {
          sfx.ok = new Audio("/sfx/correct.mp3");
          sfx.no = new Audio("/sfx/wrong.mp3");
        }
        const a = (ok ? sfx.ok : sfx.no)!;
        a.currentTime = 0;
        const p = a.play();
        if (p && p.catch) p.catch(() => {});
      } catch (e) {}
    }

    function shuffle<T>(arr: T[]): T[] {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function pickWrong(pool: string[], correct: string, n: number): string[] {
      const seen = new Set([correct]);
      const out: string[] = [];
      for (const c of shuffle(pool)) {
        if (seen.has(c)) continue;
        seen.add(c);
        out.push(c);
        if (out.length === n) break;
      }
      return out;
    }

    function build() {
      const vocab = data.vocab as { de: string; en: string; a: string }[];
      const grammar = data.grammar as { kind: string; prompt: string; answer: string; wrong: string[] }[];
      const enPool = vocab.map((w) => w.en);
      const dePool = vocab.map((w) => w.de);

      const v = shuffle(vocab).slice(0, VOCAB_N).map((w) => ({
        stage: "vocab",
        prompt: w.de,
        answer: w.en,
        audio: w.a,
        options: shuffle([w.en, ...pickWrong(enPool, w.en, 3)]),
      }));

      const g = shuffle(grammar).slice(0, GRAMMAR_N).map((item) => ({
        stage: "grammar",
        prompt: item.prompt,
        label: item.kind,
        answer: item.answer,
        audio: null,
        options: shuffle([item.answer, ...item.wrong.slice(0, 3)]),
      }));

      const l = shuffle(vocab).slice(0, LISTEN_N).map((w) => ({
        stage: "listen",
        prompt: "",
        answer: w.de,
        audio: w.a,
        options: shuffle([w.de, ...pickWrong(dePool, w.de, 3)]),
      }));

      queue = [...v, ...g, ...l];
    }

    const STAGE_LABEL: Record<string, string> = {
      vocab: "Vocabulary",
      grammar: "Grammar",
      listen: "Listening",
    };
    const STAGE_ORDER = ["vocab", "grammar", "listen"];

    function show(which: "start" | "play" | "result") {
      Object.entries(screens).forEach(([k, el]) => {
        (el as HTMLElement).hidden = k !== which;
      });
    }

    function render() {
      const item = queue[pos];
      locked = false;
      liveEl.textContent = "";
      nextBtn.disabled = true;
      nextBtn.textContent = "Lanjut";
      nextBtn.className = "btn btn-primary";
      barEl.style.width = (pos / queue.length) * 100 + "%";

      const idx = STAGE_ORDER.indexOf(item.stage);
      stageEl.textContent = `Tahap ${idx + 1} dari 3 · ${STAGE_LABEL[item.stage]} · soal ${pos + 1}/${queue.length}`;

      promptEl.textContent = item.prompt || "";
      promptEl.hidden = !item.prompt;

      // Listening items show only a speaker; vocabulary items show the word plus
      // a speaker so the learner can hear it while reading.
      speakerEl.hidden = !item.audio;
      speakerEl.innerHTML = "";
      if (item.audio) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "tts tts-md";
        b.setAttribute("data-audio", item.audio);
        b.setAttribute("aria-label", "Putar audio");
        b.setAttribute("title", "Putar audio");
        b.innerHTML =
          '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">' +
          '<path d="M4.6 13.2a7.4 7.4 0 0 1 14.8 0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>' +
          '<rect x="2.4" y="12.2" width="4.8" height="8.4" rx="2.4"/><rect x="16.8" y="12.2" width="4.8" height="8.4" rx="2.4"/></svg>';
        speakerEl.appendChild(b);
      }

      optsEl.innerHTML = "";
      for (const opt of item.options) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "lq-opt";
        b.textContent = opt;
        b.addEventListener("click", () => choose(b, opt, item));
        optsEl.appendChild(b);
      }
    }

    function choose(btn: HTMLElement, picked: string, item: any) {
      if (locked) return;
      locked = true;
      const right = picked === item.answer;
      playSfx(right);

      const all = Array.from(optsEl.querySelectorAll<HTMLElement>(".lq-opt"));
      all.forEach((b) => {
        b.classList.add("is-locked");
        if (b.textContent === item.answer) b.classList.add("is-correct");
        else if (b === btn) b.classList.add("is-wrong");
      });

      if (right) {
        scores[item.stage as keyof typeof scores] += 1;
        nextBtn.className = "btn btn-primary lq-ok";
        nextBtn.textContent = "Benar — lanjut";
      } else {
        nextBtn.className = "btn btn-primary lq-no";
        nextBtn.textContent = "Salah — jawaban: " + item.answer;
      }
      liveEl.textContent = nextBtn.textContent;
      nextBtn.disabled = false;
      nextBtn.focus();
    }

    function next() {
      if (!locked) return;
      pos += 1;
      if (pos >= queue.length) return finish();
      render();
    }

    function finish() {
      barEl.style.width = "100%";
      const total = scores.vocab + scores.grammar + scores.listen;
      scoreEl.textContent = `${total} / ${queue.length}`;
      breakdownEl.innerHTML = "";
      for (const st of STAGE_ORDER) {
        const li = document.createElement("li");
        const got = scores[st as keyof typeof scores];
        const of = totals[st as keyof typeof totals];
        li.textContent = `${STAGE_LABEL[st]} — ${got} / ${of}`;
        breakdownEl.appendChild(li);
      }
      show("result");
    }

    function start() {
      scores = { vocab: 0, grammar: 0, listen: 0 };
      totals = { vocab: VOCAB_N, grammar: GRAMMAR_N, listen: LISTEN_N };
      pos = 0;
      build();
      if (!queue.length) return;
      show("play");
      render();
    }

    q("[data-start]")!.addEventListener("click", start);
    q("[data-again]")!.addEventListener("click", start);
    nextBtn.addEventListener("click", next);
  }
</script>

<style is:global>
  /* Global, not scoped: the option buttons are created with
     document.createElement, so they never receive Astro's scoping attribute and
     scoped rules would silently skip them. Same reason ThemeQuiz is global. */
  .lq-screen[hidden] {
    display: none;
  }
  .lq-start,
  .lq-result {
    padding: 1.25rem;
  }
  .lq-kicker {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .lq-plan {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .lq-plan li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--text-strong);
  }
  .lq-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1.5px solid var(--border);
    font-weight: 900;
    font-size: 0.8rem;
  }
  .lq-meta {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .lq-bar-wrap {
    height: 0.6rem;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .lq-bar {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--text-strong);
    transition: width 0.25s ease;
  }
  .lq-stage {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-faint);
  }

  .lq-qbox {
    padding: 1.1rem;
    margin-bottom: 0.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .lq-prompt {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    text-align: center;
    color: var(--text-strong);
  }

  /* Options mirror the topic quiz exactly: same two-column grid, same 7rem tap
     target, same centred label, same green/red verdict colours. Two different
     answer styles across one app read as two different apps. */
  .lq-opts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }
  .lq-opt {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    min-height: 7rem;
    padding: 1.1rem 1rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-strong);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease, transform 0.06s ease;
  }
  .lq-opt:hover:not(.is-locked) {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .lq-opt:active:not(.is-locked) {
    transform: translateY(2px);
  }
  .lq-opt.is-locked {
    cursor: default;
  }
  .lq-opt.is-correct {
    border-color: var(--color-feather);
    background: color-mix(in srgb, var(--color-feather) 16%, transparent);
    color: var(--text-strong);
  }
  .lq-opt.is-wrong {
    border-color: var(--color-cardinal);
    background: color-mix(in srgb, var(--color-cardinal) 14%, transparent);
  }
  .lq-ok {
    background: var(--color-feather) !important;
    border-color: var(--color-feather) !important;
  }
  .lq-no {
    background: var(--color-cardinal) !important;
    border-color: var(--color-cardinal) !important;
  }
  .lq-score {
    margin: 0 0 0.75rem;
    font-size: 2rem;
    font-weight: 900;
    color: var(--text-strong);
  }
  .lq-breakdown {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--text-strong);
  }
  .lq-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
