---
// Thematic vocabulary browser.
//
// Unlike RefSearch (a flat A–Z table), a theme is organised into named groups
// (pets, farm animals, birds…). One section is rendered per group.
//
// There is deliberately no search box or level filter here: a theme is short
// enough to scan, and the point is to read the list, not to query it. The only
// control is the der/die/das filter, and only for themes that are nouns.
//
// Columns are per-theme: a noun needs a plural, an adjective does not, and a
// colour needs a swatch. A column of type "swatch" paints the word's `hex`.
interface Word {
  de: string;
  art?: string;
  en: string;
  plural?: string;
  level?: string;
  hex?: string;
}
interface Group {
  id: string;
  title: string;
  en?: string;
  words: Word[];
}
interface Column {
  key: string;
  label: string;
  type?: "text" | "swatch";
}
interface Props {
  groups: Group[];
  columns?: Column[];
  /** show the der/die/das filter (noun themes only) */
  showArticles?: boolean;
}
const {
  groups,
  columns = [
    { key: "de", label: "Deutsch" },
    { key: "en", label: "English" },
    { key: "plural", label: "Plural" },
    { key: "level", label: "Level" },
  ],
  showArticles = true,
} = Astro.props;

const total = groups.reduce((n, g) => n + g.words.length, 0);

/** Read a word's field for a column without an `as` cast (which the Astro
 *  template parser cannot handle inline). */
function field(w: Word, key: string): string {
  const v = (w as unknown as Record<string, unknown>)[key];
  return v == null ? "" : String(v);
}
---

<div class="mb-5 flex flex-wrap items-center gap-3">
  <span class="text-xs font-bold" style="color: var(--text-muted)">
    <span id="tcount">{total}</span> words
  </span>
  {
    showArticles && (
      <div class="flex flex-wrap gap-2 items-center">
        <span style="color: var(--border-strong)">|</span>
        {["der", "die", "das"].map((a) => (
          <button
            class="filter-art btn btn-ghost"
            data-art={a}
            style="padding:0.35rem 0.8rem;font-size:0.75rem"
          >
            {a}
          </button>
        ))}
      </div>
    )
  }
</div>

<div id="tempty" class="card text-center" style="display:none">
  <p style="color:var(--text-muted)">No words with that article in this topic.</p>
</div>

{
  groups.map((g) => (
    <section class="tgroup mb-10" data-group={g.id}>
      <h2 class="text-xl mb-3 flex items-baseline gap-2">
        <span style="color: var(--text-strong)">{g.title}</span>
        {g.en && <span class="text-sm font-bold" style="color: var(--text-faint)">{g.en}</span>}
      </h2>
      <div class="card" style="padding:0;overflow-x:auto;-webkit-overflow-scrolling:touch">
        <table class="w-full text-sm" style="border-collapse:collapse;min-width:max-content">
          <thead>
            <tr style="background:var(--surface-2)">
              {columns.map((c) => (
                <th
                  class="text-left px-4 py-3 font-extrabold"
                  style="color:var(--text-strong);border-bottom:2px solid var(--border)"
                >
                  {c.label}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {g.words.map((w) => (
              <tr
                class="trow"
                data-de={w.de}
                data-en={w.en}
                data-art={w.art || ""}
                data-level={w.level || ""}
              >
                {columns.map((c) => {
                  const value = field(w, c.key);
                  const cellStyle = "padding:0.6rem 1rem;border-bottom:1px solid var(--border);";
                  if (c.type === "swatch") {
                    return (
                      <td style={cellStyle}>
                        <span class="inline-flex items-center gap-2">
                          <span
                            style={`display:inline-block;width:1.1rem;height:1.1rem;border-radius:0.35rem;border:1px solid var(--border-strong);background:${value}`}
                          />
                          <span style="color:var(--text-strong);font-weight:700">{w.de}</span>
                        </span>
                      </td>
                    );
                  }
                  if (c.key === "de") {
                    return (
                      <td style={`${cellStyle}font-weight:700;color:var(--text-strong)`}>{value}</td>
                    );
                  }
                  if (c.key === "level") {
                    return <td style={`${cellStyle}color:var(--text-faint)`}>{value || "–"}</td>;
                  }
                  if (!value.trim()) {
                    return <td style={`${cellStyle}color:var(--text-faint)`}>–</td>;
                  }
                  return <td style={`${cellStyle}color:var(--text-muted)`}>{value}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}

<p class="text-center text-xs mt-8" style="color: var(--text-faint)">
  Same vocabulary as the lessons, grouped by topic.
</p>

<script is:inline>
  const countEl = document.getElementById("tcount");
  const emptyEl = document.getElementById("tempty");
  const rows = Array.from(document.querySelectorAll(".trow"));
  const sections = Array.from(document.querySelectorAll(".tgroup"));
  const total = rows.length;

  let activeArt = "";

  function render() {
    let shown = 0;

    for (const r of rows) {
      const art = r.dataset.art || "";
      const ok = !activeArt || art === activeArt;
      r.style.display = ok ? "" : "none";
      if (ok) shown++;
    }

    // Hide a whole group once none of its rows survive the filter.
    for (const s of sections) {
      const anyVisible = Array.from(s.querySelectorAll(".trow")).some(
        (r) => r.style.display !== "none"
      );
      s.style.display = anyVisible ? "" : "none";
    }

    if (countEl) countEl.textContent = String(shown);
    if (emptyEl) emptyEl.style.display = shown ? "none" : "block";
  }

  document.querySelectorAll(".filter-art").forEach((b) => {
    b.addEventListener("click", () => {
      activeArt = activeArt === b.dataset.art ? "" : b.dataset.art;
      document.querySelectorAll(".filter-art").forEach((x) => {
        x.classList.toggle("btn-primary", x.dataset.art === activeArt);
      });
      render();
    });
  });

  // Nothing is filtered on load, but run once so the count reflects reality.
  if (total === 0 && countEl) countEl.textContent = "0";
</script>
