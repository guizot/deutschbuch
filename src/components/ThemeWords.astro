---
// Thematic vocabulary browser.
//
// Unlike RefSearch (a flat A–Z table), a theme is organised into named groups
// (pets, farm animals, birds…). One section is rendered per group, and each
// group collapses: a theme can hold 40+ words across five groups, and folding
// the ones you are not reading keeps the page from becoming a long scroll.
//
// The header is its own outlined button and the table a card under it, but the
// gap between the two stays small: the header reads as the table's title rather
// than as a separate block floating above it.
//
// There is deliberately no search box or level filter here: a theme is short
// enough to scan, and the point is to read the list, not to query it. The only
// filter is the der/die/das one, and only for themes that are nouns.
//
// Columns are per-theme: a noun needs a plural, an adjective does not, and a
// colour needs a swatch. A column of type "swatch" paints the word's `hex`.
import Icon from "./Icon.astro";

interface Word {
  de: string;
  art?: string;
  en: string;
  plural?: string;
  level?: string;
  hex?: string;
}
interface Group {
  id: string;
  title: string;
  en?: string;
  words: Word[];
}
interface Column {
  key: string;
  label: string;
  type?: "text" | "swatch";
}
interface Props {
  groups: Group[];
  columns?: Column[];
  /** show the der/die/das filter (noun themes only) */
  showArticles?: boolean;
}
const {
  groups,
  columns = [
    { key: "de", label: "Deutsch" },
    { key: "en", label: "English" },
    { key: "plural", label: "Plural" },
    { key: "level", label: "Level" },
  ],
  showArticles = true,
} = Astro.props;

const total = groups.reduce((n, g) => n + g.words.length, 0);

/** Read a word's field for a column without an `as` cast (which the Astro
 *  template parser cannot handle inline). */
function field(w: Word, key: string): string {
  const v = (w as unknown as Record<string, unknown>)[key];
  return v == null ? "" : String(v);
}
---

<div class="ref-bar mb-5">
  <span class="ref-count">
    <span id="tcount">{total}</span> words
  </span>
  {
    showArticles && (
      <>
        <span class="ref-divider" aria-hidden="true">
          |
        </span>
        <div class="ref-chips no-scrollbar">
          {["der", "die", "das"].map((a) => (
            <button
              class="filter-art btn btn-ghost"
              data-art={a}
              style="padding:0.35rem 0.8rem;font-size:0.75rem"
            >
              {a}
            </button>
          ))}
        </div>
      </>
    )
  }
</div>

<div id="tempty" class="card text-center" style="display:none">
  <p style="color:var(--text-muted)">No words with that article in this topic.</p>
</div>

{
  groups.map((g) => (
    <section class="tgroup mb-6" data-group={g.id}>
      <h2 class="mb-0">
        <button
          type="button"
          class="tgroup-toggle"
          aria-expanded="true"
          aria-controls={`panel-${g.id}`}
        >
          <span class="tgroup-names">
            <span class="text-xl" style="color: var(--text-strong)">{g.title}</span>
            {g.en && <span class="text-sm font-bold" style="color: var(--text-faint)">{g.en}</span>}
          </span>
          <span class="tgroup-count">{g.words.length}</span>
          <span class="tgroup-chev" style="color: var(--text-faint)">
            <Icon name="chevron" size={24} />
          </span>
        </button>
      </h2>
      <div id={`panel-${g.id}`} class="tgroup-panel">
        <div class="card" style="padding:0;overflow-x:auto;-webkit-overflow-scrolling:touch">
          <table class="w-full text-sm" style="border-collapse:collapse;min-width:max-content">
            <thead>
              <tr style="background:var(--surface-2)">
                {columns.map((c) => (
                  <th
                    class="text-left px-4 py-3 font-extrabold"
                    style="color:var(--text-strong);border-bottom:2px solid var(--border)"
                  >
                    {c.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {g.words.map((w) => (
                <tr
                  class="trow"
                  data-de={w.de}
                  data-en={w.en}
                  data-art={w.art || ""}
                  data-level={w.level || ""}
                >
                  {columns.map((c) => {
                    const value = field(w, c.key);
                    const cellStyle = "padding:0.6rem 1rem;border-bottom:1px solid var(--border);";
                    if (c.type === "swatch") {
                      return (
                        <td style={cellStyle}>
                          <span class="inline-flex items-center gap-2">
                            <span
                              style={`display:inline-block;width:1.1rem;height:1.1rem;border-radius:0.35rem;border:1px solid var(--border-strong);background:${value}`}
                            />
                            <span style="color:var(--text-strong);font-weight:700">{w.de}</span>
                          </span>
                        </td>
                      );
                    }
                    if (c.key === "de") {
                      return (
                        <td style={`${cellStyle}font-weight:700;color:var(--text-strong)`}>{value}</td>
                      );
                    }
                    if (c.key === "level") {
                      return <td style={`${cellStyle}color:var(--text-faint)`}>{value || "–"}</td>;
                    }
                    if (!value.trim()) {
                      return <td style={`${cellStyle}color:var(--text-faint)`}>–</td>;
                    }
                    return <td style={`${cellStyle}color:var(--text-muted)`}>{value}</td>;
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))
}

<p class="text-center text-xs mt-8" style="color: var(--text-faint)">
  Same vocabulary as the lessons, grouped by topic.
</p>

<style>
  /* The group header is a button: an outlined row, so it still reads as
     clickable when its table is folded away and nothing is under it. */
  .tgroup-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.7rem 1rem;
    border: 2px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .tgroup-toggle:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  /* German title with the English gloss stacked directly under it, both
     starting at the same left edge. Takes the slack so the count chip and the
     chevron are pushed to the right edge. */
  .tgroup-names {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }
  /* The word count is a small chip pinned to the right, so the numbers line up
     in one column across groups instead of trailing each title's ragged end.
     Outlined rather than filled, so it stays legible when the row is hovered
     and the button background shifts. */
  .tgroup-count {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    padding: 0.2rem 0.6rem;
    border: 1.5px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  /* The chevron points down when open, right when closed. It sits centred
     vertically and pulled in from the right edge, not hugging the border. */
  .tgroup-chev {
    display: inline-flex;
    flex-shrink: 0;
    margin-right: 0.35rem;
    transition: transform 0.18s ease;
  }
  .tgroup-toggle[aria-expanded="false"] .tgroup-chev {
    transform: rotate(-90deg);
  }
  .tgroup-toggle:hover .tgroup-chev {
    color: var(--text-strong);
  }
  .tgroup-toggle:focus-visible {
    outline: 2px solid var(--color-macaw);
    outline-offset: 3px;
    border-radius: 6px;
  }
  /* A little more air under the header so the table reads as what it opens,
     without the two drifting apart. */
  .tgroup-panel {
    padding-top: 0.9rem;
  }
</style>

<script is:inline>
  const countEl = document.getElementById("tcount");
  const emptyEl = document.getElementById("tempty");
  const rows = Array.from(document.querySelectorAll(".trow"));
  const sections = Array.from(document.querySelectorAll(".tgroup"));

  // Group ids the reader has folded away. Kept in memory only: a reload starts
  // with everything open, which is what you want when you arrive at a topic.
  const collapsed = new Set();

  let activeArt = "";

  function applyPanels() {
    for (const s of sections) {
      const panel = s.querySelector(".tgroup-panel");
      const btn = s.querySelector(".tgroup-toggle");
      if (!panel || !btn) continue;
      const closed = collapsed.has(s.dataset.group);
      panel.style.display = closed ? "none" : "";
      btn.setAttribute("aria-expanded", closed ? "false" : "true");
    }
  }

  function render() {
    let shown = 0;

    for (const r of rows) {
      const art = r.dataset.art || "";
      const ok = !activeArt || art === activeArt;
      r.style.display = ok ? "" : "none";
      if (ok) shown++;
    }

    // Hide a whole group once none of its rows survive the filter.
    for (const s of sections) {
      const anyVisible = Array.from(s.querySelectorAll(".trow")).some(
        (r) => r.style.display !== "none"
      );
      s.style.display = anyVisible ? "" : "none";
    }

    if (countEl) countEl.textContent = String(shown);
    if (emptyEl) emptyEl.style.display = shown ? "none" : "block";
    applyPanels();
  }

  document.querySelectorAll(".tgroup-toggle").forEach((b) => {
    b.addEventListener("click", () => {
      const id = b.closest(".tgroup").dataset.group;
      if (collapsed.has(id)) collapsed.delete(id);
      else collapsed.add(id);
      applyPanels();
    });
  });

  document.querySelectorAll(".filter-art").forEach((b) => {
    b.addEventListener("click", () => {
      activeArt = activeArt === b.dataset.art ? "" : b.dataset.art;
      document.querySelectorAll(".filter-art").forEach((x) => {
        x.classList.toggle("btn-primary", x.dataset.art === activeArt);
      });
      render();
    });
  });

  applyPanels();
</script>
