---
import ThemeToggle from "../components/ThemeToggle.astro";
import Icon from "../components/Icon.astro";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;

// custom icon (see src/lib/icons.ts) for the mobile bottom bar, label for the desktop nav
const links = [
  { href: "/", label: "Learn", key: "learn", icon: "flag" },
  { href: "/search", label: "Search", key: "search", icon: "search", mobileHide: true },
  { href: "/reference", label: "Reference", key: "reference", icon: "book" },
  { href: "/themes", label: "Topics", key: "themes", icon: "books" },
  { href: "/progress", label: "Progress", key: "progress", icon: "chart" },
  { href: "/about", label: "About", key: "about", icon: "info" },
];

// The mobile bottom bar has no room for a sixth tab, so Search is hidden there
// and surfaced as an icon button next to the theme toggle instead.
const mobileLinks = links.filter((l) => !l.mobileHide);
const headerMobileLink = links.find((l) => l.mobileHide);
---
<!-- Top bar: brand + (desktop only) the full nav + theme toggle -->
<header
  class="sticky top-0 z-50 border-b-2"
  style="background: var(--surface); border-color: var(--border);"
>
  <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <Icon name="flag" size={28} style="color: var(--color-feather)" />
      <span class="font-black text-lg" style="color: var(--text-strong)">
        Deutschbuch
      </span>
    </a>

    <!-- Right side: the full nav (desktop only) and the theme toggle. The nav
         items are icon-only buttons, styled like the theme toggle. The group is
         pushed right with ml-auto so the menu hugs the toggle instead of
         floating in the middle. On mobile the nav is hidden and only the toggle
         shows here; the nav lives in the bottom bar below. -->
    <div class="flex items-center gap-2 ml-auto">
      <nav class="hidden sm:flex items-center gap-2" aria-label="Main navigation">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="btn btn-ghost"
              style="padding: 0.5rem 0.6rem; text-transform: none; letter-spacing: 0;"
              aria-label={l.label}
              title={l.label}
            >
              <span
                style={
                  active === l.key
                    ? "display:inline-flex;color:var(--color-feather);"
                    : "display:inline-flex;"
                }
              >
                <Icon name={l.icon} size={22} />
              </span>
            </a>
          ))
        }
      </nav>

      <!-- Mobile only: Search lives here (next to the theme toggle) instead of
           the bottom bar, which has no room for a sixth tab. -->
      <a
        href={headerMobileLink.href}
        class="btn btn-ghost sm:hidden"
        style="padding: 0.5rem 0.6rem; text-transform: none; letter-spacing: 0;"
        aria-label={headerMobileLink.label}
        title={headerMobileLink.label}
      >
        <span
          style={
            active === headerMobileLink.key
              ? "display:inline-flex;color:var(--color-feather);"
              : "display:inline-flex;"
          }
        >
          <Icon name={headerMobileLink.icon} size={22} />
        </span>
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>

<!-- Mobile bottom bar: five icon tabs, the pattern native apps (and Duolingo)
     use. Replaces the horizontal top nav on narrow screens so nothing is
     clipped. -->
<nav
  class="sm:hidden fixed bottom-0 inset-x-0 z-50 border-t-2"
  style="background: var(--surface); border-color: var(--border); padding-bottom: env(safe-area-inset-bottom);"
  aria-label="Main navigation"
>
  <div class="flex items-stretch justify-around">
    {
      mobileLinks.map((l) => (
        <a
          href={l.href}
          class="flex flex-col items-center gap-0.5 py-2 px-1 flex-1 min-w-0 transition-colors"
          style={
            active === l.key ? "color: var(--color-feather);" : "color: var(--text-muted);"
          }
        >
          <Icon name={l.icon} size={24} />
          <span class="text-[10px] font-extrabold truncate w-full text-center">
            {l.label}
          </span>
        </a>
      ))
    }
  </div>
</nav>
