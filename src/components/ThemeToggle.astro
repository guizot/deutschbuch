---
// Toggles .dark on <html> and persists the choice.
import Icon from "./Icon.astro";
---
<button
  id="theme-toggle"
  class="btn btn-ghost"
  style="padding: 0.5rem 0.6rem; font-size: 1.1rem; text-transform: none; letter-spacing: 0;"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <span id="theme-icon" style="display:inline-flex">
    <Icon name="moon" size={22} />
  </span>
</button>

<script>
  import { iconSvg } from "../lib/icons";

  const root = document.documentElement;
  const icon = document.getElementById("theme-icon");
  const btn = document.getElementById("theme-toggle");

  function paint() {
    const dark = root.classList.contains("dark");
    if (icon) icon.innerHTML = iconSvg(dark ? "sun" : "moon", 22);
  }
  paint();

  btn?.addEventListener("click", () => {
    root.classList.toggle("dark");
    try {
      localStorage.setItem("gv-theme", root.classList.contains("dark") ? "dark" : "light");
    } catch (e) {}
    paint();
  });
</script>
