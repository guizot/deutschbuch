---
interface Props {
  label?: string;
  href?: string;
  variant?: "primary" | "secondary" | "danger" | "ghost";
  size?: "sm" | "md" | "lg";
  id?: string;
  disabled?: boolean;
}
const {
  label = "Button",
  href,
  variant = "primary",
  size = "md",
  id,
  disabled = false,
} = Astro.props;

const pad =
  size === "sm" ? "0.55rem 1rem" : size === "lg" ? "1rem 2rem" : "0.85rem 1.5rem";
const cls = `btn btn-${variant}`;
const style = `padding:${pad};`;
---
{
  href ? (
    <a class={cls} style={style} href={href} id={id}>
      <slot>{label}</slot>
    </a>
  ) : (
    <button class={cls} style={style} id={id} disabled={disabled}>
      <slot>{label}</slot>
    </button>
  )
}
