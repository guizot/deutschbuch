---
// Inline theme bootstrap. Runs before first paint so there is no flash of
// the wrong theme. Kept tiny and inlined on purpose.
const themeScript = `
(function () {
  try {
    var stored = localStorage.getItem('gv-theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var dark = stored ? stored === 'dark' : prefersDark;
    if (dark) document.documentElement.classList.add('dark');
  } catch (e) {}
})();
`;

// One delegated handler for every pronunciation button on the page. It lives in
// the layout — not in AudioButton.astro — because vocabulary tables get their
// buttons injected as raw HTML from lib/md.ts, on pages that never import the
// component.
const audioScript = `
(function () {
  var player = new Audio();
  var current = null;

  function stop(btn) {
    if (btn) btn.classList.remove('is-playing');
  }

  document.addEventListener('click', function (event) {
    var target = event.target;
    var btn = target && target.closest ? target.closest('[data-audio]') : null;
    if (!btn) return;

    // Keep the click from also toggling a table row or an accordion.
    event.preventDefault();
    event.stopPropagation();

    var src = btn.getAttribute('data-audio');
    if (!src) return;

    stop(current);
    player.pause();
    player.currentTime = 0;
    player.src = src;
    btn.classList.add('is-playing');
    current = btn;

    var p = player.play();
    if (p && p.catch) p.catch(function () { stop(btn); current = null; });
  });

  player.addEventListener('ended', function () {
    stop(current);
    current = null;
  });
})();
`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Deutschbuch</title>
    <meta name="description" content="Duolingo-style viewer for the German A1-C1 course." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <slot />
    <script is:inline set:html={audioScript} />
  </body>
</html>
