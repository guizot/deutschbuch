---
// Progress state lives in localStorage. This island reads it and paints the
// skill path: node states and the stats. Zero framework, ~3 KB of vanilla JS.
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { LEVELS } from "../data/site.ts";
import meta from "../content/meta.json";
import "../styles/global.css";

const byLevel = Object.fromEntries(
  LEVELS.map((l) => [l.id, meta.filter((m) => m.level === l.id)])
);

const totalLessons = meta.length;

// Horizontal offsets (px) that make the path wind down the page. A 4-step
// cycle keeps every turn the same size, so the dotted trail stays even.
const POS = [0, 52, 0, -52];
const TRAIL_H = 34; // px between two node centres (the connector height)

// Dots that draw the trail between the previous node and this one.
function trailDots(i: number) {
  if (i === 0) return [];
  const x0 = POS[(i - 1) % 4];
  const x1 = POS[i % 4];
  return [0.34, 0.67].map((t) => ({
    x: x0 + (x1 - x0) * t,
    y: t * TRAIL_H,
  }));
}
---

<BaseLayout>
  <Header active="learn" />

  <main class="max-w-3xl mx-auto px-4 pb-24">
    <!-- Stats bar: flags earned, streak, XP -->
    <section class="sticky top-16 z-40 py-3" style="background: var(--bg);">
      <div class="card flex items-center justify-between" style="padding: 0.7rem 1rem;">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5 font-extrabold" style="color: var(--color-feather);">
            <Icon name="flag" size={20} /> <span id="stat-done">0</span>
          </span>
          <span class="flex items-center gap-1.5 font-extrabold" style="color: var(--color-fox);">
            <Icon name="fire" size={20} /> <span id="stat-streak">0</span>
          </span>
          <span class="flex items-center gap-1.5 font-extrabold" style="color: var(--color-bee);">
            <Icon name="star" size={20} /> <span id="stat-xp">0</span>
          </span>
        </div>
        <span class="text-sm font-extrabold" style="color: var(--text-muted);">
          <span id="stat-done-2">0</span>/<span>{totalLessons}</span> lessons
        </span>
      </div>
    </section>

    <!-- Overall progress -->
    <section class="mb-8">
      <div class="progress-track">
        <div class="progress-fill" id="overall-fill" style="width:0%"></div>
      </div>
    </section>

    <!-- Level units -->
    {
      LEVELS.map((lv) => {
        const lessons = byLevel[lv.id] || [];
        return (
          <section class="mb-16" data-level={lv.id}>
            <!-- Unit banner (coloured per level, like Duolingo's section header) -->
            <div class={`unit-banner ${lv.color}`}>
              <div class="min-w-0">
                <div class="text-[11px] font-black uppercase tracking-widest opacity-90">
                  Level {lv.label} · {lv.hours}
                </div>
                <div class="text-xl font-black leading-tight">{lv.name}</div>
                <p class="text-sm mt-0.5 opacity-90 leading-snug">{lv.blurb}</p>
              </div>
              <Icon name={lv.icon} size={46} class="unit-banner-icon" />
            </div>

            <!-- Skill path -->
            <div class="flex flex-col items-center">
              {lessons.map((l, i) => (
                <>
                  {i > 0 && (
                    <div class="trail" style={`height:${TRAIL_H}px`}>
                      {trailDots(i).map((d) => (
                        <span
                          class="trail-dot"
                          style={`left:calc(50% + ${d.x}px);top:${d.y}px`}
                        />
                      ))}
                    </div>
                  )}
                  <div class="node-wrap" style={`transform:translateX(${POS[i % 4]}px)`}>
                    <a
                      href={`/${lv.id}/${l.slug}/`}
                      class={`skill-node node-${lv.id}`}
                      data-lesson={`${lv.id}/${l.slug}`}
                      data-type={l.type}
                      title={l.title}
                      aria-label={l.title}
                    >
                      <span class="node-glyph">
                        <Icon name={l.type} size={34} />
                      </span>
                      <span class="node-num">{l.num}</span>
                    </a>
                    <span
                      class="text-xs font-extrabold text-center max-w-[170px] leading-snug"
                      style="color: var(--text-strong)"
                    >
                      {l.title}
                    </span>
                  </div>
                </>
              ))}
            </div>

            <div class="text-center mt-8">
              <a
                href={`/${lv.id}/`}
                class="btn btn-ghost"
                style="padding:0.6rem 1.2rem;font-size:0.8rem"
              >
                View {lv.label} overview
              </a>
            </div>
          </section>
        );
      })
    }

    <!-- Reference CTA -->
    <section class="card text-center" style="border-color: var(--color-macaw);">
      <div class="mb-2 flex justify-center" style="color: var(--color-macaw)">
        <Icon name="book" size={32} />
      </div>
      <h2 class="text-xl mb-1">Reference library</h2>
      <p class="text-sm mb-4" style="color: var(--text-muted)">
        Dictionary, nouns, verbs, phrases and the grammar cheat sheet.
      </p>
      <a href="/reference/" class="btn btn-secondary">Open reference</a>
    </section>
  </main>

  <script>
    import { iconSvg } from "../lib/icons";

    // ---- progress state (localStorage) -------------------------------------
    const KEY = "gv-progress-v1";

    function loadState() {
      try {
        return JSON.parse(localStorage.getItem(KEY) || "{}");
      } catch {
        return {};
      }
    }

    const state = loadState();
    const done = state.lessons || {};
    const doneCount = Object.values(done).filter(Boolean).length;

    // Paint node states
    const nodes = [...document.querySelectorAll("[data-lesson]")];
    let currentMarked = false;

    nodes.forEach((node) => {
      const id = node.dataset.lesson;
      const glyph = node.querySelector(".node-glyph");
      if (done[id]) {
        node.classList.add("skill-done");
        // The milestone node keeps its trophy; every other lesson shows a check.
        if (node.dataset.type !== "trophy" && glyph) {
          glyph.innerHTML = iconSvg("check", 34);
        }
      } else if (!currentMarked) {
        // First lesson not yet completed: this is where the learner continues.
        node.classList.add("skill-current");
        currentMarked = true;
      }
    });

    // Stats
    document.getElementById("stat-done").textContent = String(doneCount);
    document.getElementById("stat-done-2").textContent = String(doneCount);
    document.getElementById("stat-xp").textContent = String(doneCount * 10);
    document.getElementById("stat-streak").textContent = String(state.streak || 0);
    const total = document.querySelectorAll("[data-lesson]").length;
    document.getElementById("overall-fill").style.width =
      total ? (doneCount / total) * 100 + "%" : "0%";
  </script>
</BaseLayout>
