---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";
import BackLink from "../../components/BackLink.astro";
import ThemeWords from "../../components/ThemeWords.astro";
import themesData from "../../data/themes.json";
import "../../styles/global.css";

export function getStaticPaths() {
  return themesData.themes.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}

const { theme } = Astro.props;

// Noun themes get the der/die/das filter; adjective/number themes do not.
const hasArticles = theme.groups.some((g) => g.words.some((w) => w.art));
const hasPlurals = theme.groups.some((g) => g.words.some((w) => w.plural));
const columns = theme.columns ?? [
  { key: "de", label: "Deutsch" },
  { key: "en", label: "English" },
  ...(hasPlurals ? [{ key: "plural", label: "Plural" }] : []),
  { key: "level", label: "Level" },
];
---
<BaseLayout>
  <Header active="themes" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback="/themes/" label="Topics" />

    <PageHeader
      icon={theme.icon}
      color={theme.tint}
      title={theme.title}
      en={theme.subtitle}
      class="theme-head"
    >
      <p class="theme-intro" set:html={theme.intro} />
    </PageHeader>

    <ThemeWords groups={theme.groups} columns={columns} showArticles={hasArticles} />

    {
      theme.notes?.length > 0 && (
        <section class="mt-14 pt-8 border-t-2" style="border-color: var(--border)">
          <h2 class="text-2xl mb-4 flex items-center gap-2" style={`color: ${theme.tint}`}>
            <Icon name="bulb" size={26} />
            <span style="color: var(--text-strong)">Things to remember</span>
          </h2>
          <ul class="space-y-3">
            {theme.notes.map((n) => (
              <li class="flex gap-3">
                <span style={`color: ${theme.tint}; flex-shrink:0`}>•</span>
                <span style="color: var(--text)" set:html={n} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <style>
    /* The theme intro sits inside the shared PageHeader, so it just needs the
       usual muted colour and a little breathing room above it. */
    .theme-intro {
      margin-top: 0.6rem;
      color: var(--text-muted);
    }
  </style>
</BaseLayout>
