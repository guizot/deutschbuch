---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";
import BackLink from "../../components/BackLink.astro";
import ThemeWords from "../../components/ThemeWords.astro";
import themesData from "../../data/themes.json";
import "../../styles/global.css";

export function getStaticPaths() {
  return themesData.themes.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}

const { theme } = Astro.props;

// Noun themes get the der/die/das filter; adjective/number themes do not.
const hasArticles = theme.groups.some((g) => g.words.some((w) => w.art));
const hasPlurals = theme.groups.some((g) => g.words.some((w) => w.plural));
const columns = theme.columns ?? [
  { key: "de", label: "Deutsch" },
  { key: "en", label: "English" },
  ...(hasPlurals ? [{ key: "plural", label: "Plural" }] : []),
  { key: "level", label: "Level" },
];
---
<BaseLayout>
  <Header active="themes" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback="/themes/" label="Topics" />

    <PageHeader
      icon={theme.icon}
      color={theme.tint}
      title={theme.title}
      en={theme.subtitle}
      class="theme-head"
    >
      <p class="theme-intro" set:html={theme.intro} />
    </PageHeader>

    <ThemeWords groups={theme.groups} columns={columns} showArticles={hasArticles} />

    {
      theme.groups.reduce((n, g) => n + g.words.length, 0) >= 4 && (
        <section class="quiz-cta">
          <div class="quiz-cta-card">
            <div class="quiz-cta-top">
              <span class="quiz-cta-icon" style={`color:${theme.tint}`}>
                <Icon name="question" size={30} />
              </span>
              <div class="min-w-0">
                <h2 class="quiz-cta-title">Quiz</h2>
                <p class="quiz-cta-sub">
                  Uji topik ini — pilih arah soalnya dulu, lalu mulai.
                </p>
              </div>
            </div>
            <div class="quiz-cta-actions">
              <a
                href={`/themes/${theme.slug}/quiz/?mode=de-en`}
                class="btn btn-primary quiz-cta-btn"
              >
                <span class="quiz-dir-flag">DE → EN</span>
                <span class="quiz-dir-sub">Jerman → Inggris</span>
              </a>
              <a
                href={`/themes/${theme.slug}/quiz/?mode=en-de`}
                class="btn btn-secondary quiz-cta-btn"
              >
                <span class="quiz-dir-flag">EN → DE</span>
                <span class="quiz-dir-sub">Inggris → Jerman</span>
              </a>
            </div>
          </div>
        </section>
      )
    }

    {
      theme.notes?.length > 0 && (
        <section class="mt-14 pt-8 border-t-2" style="border-color: var(--border)">
          <h2 class="text-2xl mb-4 flex items-center gap-2" style={`color: ${theme.tint}`}>
            <Icon name="bulb" size={26} />
            <span style="color: var(--text-strong)">Things to remember</span>
          </h2>
          <ul class="space-y-3">
            {theme.notes.map((n) => (
              <li class="flex gap-3">
                <span style={`color: ${theme.tint}; flex-shrink:0`}>•</span>
                <span style="color: var(--text)" set:html={n} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <style>
    /* The theme intro sits inside the shared PageHeader as its subtitle line,
       so it carries the same top margin and leading as .page-head-sub — that
       keeps the gap under the English title equal to the one above it. */
    .theme-intro {
      margin-top: 0.4rem;
      line-height: 1.4;
      color: var(--text-muted);
    }

    /* Quiz call-to-action, below the word list: a card that reads like the
       topic's own blocks, with the action button full-width so it is an easy
       tap on a phone. */
    .quiz-cta {
      margin-top: 2.5rem;
    }
    .quiz-cta-card {
      border: 2px solid var(--border);
      border-radius: var(--radius-card);
      background: var(--surface);
      padding: 1.2rem;
    }
    .quiz-cta-top {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .quiz-cta-icon {
      display: flex;
      align-items: center;
      flex: none;
    }
    .quiz-cta-title {
      font-size: 1.5rem;
      line-height: 1.2;
      margin: 0;
    }
    .quiz-cta-sub {
      margin-top: 0.3rem;
      line-height: 1.4;
      color: var(--text-muted);
      font-size: 0.9rem;
    }
    .quiz-cta-btn {
      width: 100%;
      justify-content: center;
      text-transform: none;
      letter-spacing: 0;
      flex-direction: column;
      gap: 0.15rem;
    }
    /* The two directions sit side by side, each a full-width tap target of its
       own column. */
    .quiz-cta-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.7rem;
    }
    .quiz-dir-flag {
      font-weight: 900;
      font-size: 1rem;
    }
    .quiz-dir-sub {
      font-size: 0.75rem;
      font-weight: 700;
      opacity: 0.9;
    }
  </style>
</BaseLayout>
