---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import BackLink from "../../components/BackLink.astro";
import ThemeWords from "../../components/ThemeWords.astro";
import themesData from "../../data/themes.json";
import "../../styles/global.css";

export function getStaticPaths() {
  return themesData.themes.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}

const { theme } = Astro.props;
const total = theme.groups.reduce((n, g) => n + g.words.length, 0);
---
<BaseLayout>
  <Header active="themes" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback="/themes/" label="Themen" />

    <h1 class="text-3xl mb-2 flex items-center gap-2">
      <Icon name={theme.icon} size={30} style={`color: ${theme.tint}`} />
      {theme.title}
      <span class="text-lg font-bold" style="color: var(--text-faint)">{theme.subtitle}</span>
    </h1>
    <p class="mb-8" style="color: var(--text-muted)">{theme.intro}</p>

    <ThemeWords groups={theme.groups} placeholder={`Search ${total} words… e.g. Hund, cat, die`} />

    {
      theme.notes?.length > 0 && (
        <section class="mt-14 pt-8 border-t-2" style="border-color: var(--border)">
          <h2 class="text-2xl mb-4 flex items-center gap-2" style="color: var(--color-fox)">
            <Icon name="bulb" size={26} />
            <span style="color: var(--text-strong)">Things to remember</span>
          </h2>
          <ul class="space-y-3">
            {theme.notes.map((n) => (
              <li class="flex gap-3">
                <span style="color: var(--color-fox); flex-shrink:0">•</span>
                <span style="color: var(--text)" set:html={n} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>
