---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import themesData from "../../data/themes.json";
import "../../styles/global.css";

const themes = themesData.themes;

// Group the cards under headings so a long list stays navigable.
const CATEGORY_ORDER = [
  "Grundlagen",
  "Menschen",
  "Alltag",
  "Stadt & Reisen",
  "Natur",
  "Arbeit & Lernen",
  "Freizeit",
  "Gesellschaft",
  "Grammatik",
];
const CATEGORY_SUB: Record<string, string> = {
  Grundlagen: "Colours, numbers, shapes, time",
  Menschen: "Family, body, character, feelings, health",
  Alltag: "Food, clothing, shopping, the kitchen, the home",
  "Stadt & Reisen": "Town, transport, countries, small talk",
  Natur: "Animals, landscape, weather, environment",
  "Arbeit & Lernen": "Jobs, office, school, computers",
  Freizeit: "Sport, music, festivals, communication",
  Gesellschaft: "Society, politics and the media",
  Grammatik: "Verb and preposition patterns",
};
/** English name of each category, shown next to the German one. */
const CATEGORY_EN: Record<string, string> = {
  Grundlagen: "Basics",
  Menschen: "People",
  Alltag: "Everyday life",
  "Stadt & Reisen": "Town & Travel",
  Natur: "Nature",
  "Arbeit & Lernen": "Work & Study",
  Freizeit: "Free Time",
  Gesellschaft: "Society",
  Grammatik: "Grammar",
};
/** Icon + tile colour for each category, matching the topic-card style. */
const CATEGORY_META: Record<string, { icon: string; color: string }> = {
  Grundlagen: { icon: "shapes", color: "lv-a1" },
  Menschen: { icon: "person", color: "lv-a2" },
  Alltag: { icon: "house", color: "lv-b2" },
  "Stadt & Reisen": { icon: "compass", color: "lv-c1" },
  Natur: { icon: "leaf", color: "lv-a1" },
  "Arbeit & Lernen": { icon: "briefcase", color: "lv-red" },
  Freizeit: { icon: "ball", color: "lv-b2" },
  Gesellschaft: { icon: "globe", color: "lv-a2" },
  Grammatik: { icon: "grammar", color: "lv-c1" },
};

const groups = CATEGORY_ORDER.map((cat) => ({
  cat,
  en: CATEGORY_EN[cat] || "",
  sub: CATEGORY_SUB[cat] || "",
  icon: CATEGORY_META[cat]?.icon || "books",
  color: CATEGORY_META[cat]?.color || "lv-a1",
  items: themes.filter((t) => t.category === cat),
})).filter((g) => g.items.length > 0);

/** "Stadt & Reisen" -> "stadt-reisen", a safe id fragment for aria-controls. */
const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/ä/g, "ae")
    .replace(/ö/g, "oe")
    .replace(/ü/g, "ue")
    .replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const totalWords = themes.reduce(
  (n, t) => n + t.groups.reduce((m, g) => m + g.words.length, 0),
  0
);
---
<BaseLayout>
  <Header active="themes" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <h1 class="text-3xl mb-2 flex items-center gap-2">
      <Icon name="books" size={30} style="color: var(--color-fox)" /> Topics
    </h1>
    <p class="mb-8" style="color: var(--text-muted)">
      Vocabulary by topic — {themes.length} themes, {totalWords} words. Not a lesson: a browsable
      word list, grouped the way a phrasebook groups things.
    </p>

    {
      groups.map((g) => (
        <section class="tcat mb-8" data-cat={g.cat}>
          <h2 class="mb-0">
            <button
              type="button"
              class="tcat-toggle"
              aria-expanded="true"
              aria-controls={`panel-${slug(g.cat)}`}
            >
              <span
                class={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 ${g.color}`}
                style="color:#fff"
              >
                <Icon name={g.icon} size={26} />
              </span>
              <span class="tcat-body">
                <span class="tcat-head">
                  <span class="text-xl" style="color: var(--text-strong)">{g.cat}</span>
                  {g.en && (
                    <span class="tcat-en" style="color: var(--text-faint)">
                      {g.en}
                    </span>
                  )}
                  <span class="text-xs font-bold" style="color: var(--text-faint)">
                    {g.items.length}
                  </span>
                </span>
                {g.sub && (
                  <span class="text-sm tcat-sub" style="color: var(--text-muted)">
                    {g.sub}
                  </span>
                )}
              </span>
              <span class="tcat-chev" style="color: var(--text-faint)">
                <Icon name="chevron" size={24} />
              </span>
            </button>
          </h2>
          <div id={`panel-${slug(g.cat)}`} class="tcat-panel">
            <div class="grid sm:grid-cols-2 gap-4">
              {g.items.map((t) => (
                <a
                  href={`/themes/${t.slug}/`}
                  class="card card-hover no-underline"
                  style="color:inherit"
                >
                  <div class="flex items-start gap-4">
                    <div
                      class={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 ${t.color}`}
                      style="color:#fff"
                    >
                      <Icon name={t.icon} size={26} />
                    </div>
                    <div class="min-w-0">
                      <div class="font-extrabold text-lg" style="color: var(--text-strong)">
                        {t.title}
                        {t.subtitle && (
                          <span class="text-sm font-bold" style="color: var(--text-faint)">
                            {" "}{t.subtitle}
                          </span>
                        )}
                      </div>
                      <p class="text-sm mb-2" style="color: var(--text-muted)">
                        {t.desc}
                      </p>
                      <span class="pill" style="background:var(--surface-2);color:var(--text-muted)">
                        {t.count}
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </main>

  <style>
    /* The category header is a button: an outlined row, so it still reads as
       clickable when its cards are folded away and nothing is under it. The
       description sits inside the button, under the title, and the chevron is
       centred vertically against the whole two-line block. */
    .tcat-toggle {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      padding: 0.7rem 1rem;
      border: 2px solid var(--border);
      border-radius: var(--radius-card);
      background: var(--surface);
      color: inherit;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.12s ease, background 0.12s ease;
    }
    .tcat-toggle:hover {
      border-color: var(--border-strong);
      background: var(--surface-2);
    }
    .tcat-body {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      flex: 1;
      min-width: 0;
    }
    .tcat-head {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .tcat-en {
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.2px;
    }
    .tcat-sub {
      display: block;
    }
    .tcat-chev {
      display: inline-flex;
      flex-shrink: 0;
      /* Pull it in from the right edge: centred, not hugging the border. */
      margin-right: 0.35rem;
      transition: transform 0.18s ease;
    }
    .tcat-toggle[aria-expanded="false"] .tcat-chev {
      transform: rotate(-90deg);
    }
    .tcat-toggle:hover .tcat-chev {
      color: var(--text-strong);
    }
    .tcat-toggle:focus-visible {
      outline: 2px solid var(--color-macaw);
      outline-offset: 3px;
      border-radius: 6px;
    }
    .tcat-panel {
      padding-top: 1rem;
    }
  </style>

  <script is:inline>
    const sections = Array.from(document.querySelectorAll(".tcat"));
    const collapsed = new Set();

    function apply() {
      for (const s of sections) {
        const panel = s.querySelector(".tcat-panel");
        const btn = s.querySelector(".tcat-toggle");
        const closed = collapsed.has(s.dataset.cat);
        panel.style.display = closed ? "none" : "";
        btn.setAttribute("aria-expanded", closed ? "false" : "true");
      }
    }

    document.querySelectorAll(".tcat-toggle").forEach((b) => {
      b.addEventListener("click", () => {
        const cat = b.closest(".tcat").dataset.cat;
        if (collapsed.has(cat)) collapsed.delete(cat);
        else collapsed.add(cat);
        apply();
      });
    });

    apply();
  </script>
</BaseLayout>
