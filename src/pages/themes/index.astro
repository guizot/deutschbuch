---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ItemCard from "../../components/ItemCard.astro";
import themesData from "../../data/themes.json";
import { CATEGORIES } from "../../data/categories.ts";
import "../../styles/global.css";

const themes = themesData.themes;

const totalWords = themes.reduce(
  (n, t) => n + t.groups.reduce((m, g) => m + g.words.length, 0),
  0
);

// One card per category, each linking to the page that lists its themes.
const groups = CATEGORIES.map((c) => ({
  ...c,
  items: themes.filter((t) => t.category === c.name),
})).filter((g) => g.items.length > 0);
---
<BaseLayout>
  <Header active="themes" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <PageHeader
      icon="books"
      color="var(--color-fox)"
      title="Themen"
      en="Topics"
      subtitle={`Vocabulary by topic — ${themes.length} themes, ${totalWords} words. Not a lesson: a browsable word list, grouped the way a phrasebook groups things.`}
    />

    <div class="grid sm:grid-cols-2 gap-4">
      {
        groups.map((g) => (
          <ItemCard
            href={`/themes/kategorie/${g.slug}/`}
            icon={g.icon}
            color={g.color}
            title={g.name}
            en={g.en}
            desc={g.sub}
            count={`${g.items.length} themes`}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
