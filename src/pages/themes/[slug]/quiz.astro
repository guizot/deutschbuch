---
/**
 * Quiz page for one topic: /themes/<slug>/quiz/
 *
 * A sibling of the topic page itself, so the topic keeps its own URL and the
 * quiz gets one of its own — which is what makes "Start Quiz" lead to a real
 * page (shareable, back-button friendly) rather than toggling a panel.
 */
import Header from "../../../components/Header.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import BackLink from "../../../components/BackLink.astro";
import ThemeQuiz from "../../../components/ThemeQuiz.astro";
import themesData from "../../../data/themes.json";
import "../../../styles/global.css";

export function getStaticPaths() {
  return themesData.themes.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}

const { theme } = Astro.props;
const total = theme.groups.reduce((n, g) => n + g.words.length, 0);
---

<BaseLayout>
  <Header active="themes" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback={`/themes/${theme.slug}/`} label={theme.title} />

    <PageHeader
      class="tq-head"
      icon="question"
      color={theme.tint}
      title="Quiz"
      en={`${theme.title} · ${theme.subtitle} · ${total} words`}
    />

    <ThemeQuiz slug={theme.slug} theme={theme} />
  </main>
</BaseLayout>

<style is:global>
  /* Trim the header's usual 2rem bottom margin down to the 0.7rem the quiz uses
     between the question box and the options, so the progress bar is spaced the
     same above and below. Needs to beat the scoped `.page-head` rule. */
  header.page-head.tq-head {
    margin-bottom: 0.7rem;
  }
</style>
