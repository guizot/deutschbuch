---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ItemCard from "../../components/ItemCard.astro";
import { REFERENCES } from "../../data/site.ts";
import "../../styles/global.css";
---
<BaseLayout>
  <Header active="reference" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <PageHeader
      icon="book"
      color="var(--color-macaw)"
      title="Nachschlagewerk"
      en="Reference library"
      subtitle="Five tools that cover the whole course. Built from the same source files, so they are always in sync with the lessons."
    />

    <div class="grid sm:grid-cols-2 gap-4">
      {
        REFERENCES.map((r) => (
          <ItemCard
            href={`/reference/${r.slug}/`}
            icon={r.icon}
            color={r.color}
            title={r.title}
            en={r.en}
            desc={r.desc}
            count={r.count}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
