---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { REFERENCES } from "../../data/site.ts";
import "../../styles/global.css";
---
<BaseLayout>
  <Header active="reference" />

  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <h1 class="text-3xl mb-2 flex items-center gap-2">
      <Icon name="book" size={30} style="color: var(--color-macaw)" /> Reference library
    </h1>
    <p class="mb-10" style="color: var(--text-muted)">
      Five tools that cover the whole course. Built from the same source files, so they are always
      in sync with the lessons.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      {
        REFERENCES.map((r) => (
          <a
            href={`/reference/${r.slug}/`}
            class="card card-hover no-underline"
            style="color:inherit"
          >
            <div class="flex items-center gap-4">
              <div
                class={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 ${r.color}`}
                style="color:#fff"
              >
                <Icon name={r.icon} size={26} />
              </div>
              <div class="min-w-0">
                <div class="font-extrabold text-lg" style="color: var(--text-strong)">
                  {r.title}
                </div>
                <div class="ref-en font-bold" style="color: var(--text-faint)">
                  {r.en}
                </div>
              </div>
            </div>
            <p class="text-sm ref-desc" style="color: var(--text-muted)">
              {r.desc}
            </p>
            <span class="pill" style="background:var(--surface-2);color:var(--text-muted)">
              {r.count}
            </span>
          </a>
        ))
      }
    </div>
  </main>

  <style>
    /* English gloss sits on its own line right under the German title, tight
       against it — the same pattern as the topic cards. */
    .ref-en {
      font-size: 0.8rem;
      line-height: 1.2;
      margin-top: 0.05rem;
    }
    /* Description and badge span the full card width, starting at the icon's
       left edge rather than under the title, so the card reads as a block. */
    .ref-desc {
      margin-top: 0.7rem;
      margin-bottom: 0.6rem;
    }
  </style>
</BaseLayout>
