---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RefSearch from "../../components/RefSearch.astro";
import RefGuide from "../../components/RefGuide.astro";
import Icon from "../../components/Icon.astro";
import BackLink from "../../components/BackLink.astro";
import verbs from "../../data/verbs.json";
import "../../styles/global.css";

const TYPE_LABEL = {
  core: "core",
  modal: "modal",
  strong: "strong",
  weak: "weak",
  separable: "separable",
  reflexive: "reflexive",
  ieren: "-ieren",
};

// Decorate for display
const items = verbs.map((v) => ({
  ...v,
  typeLabel: TYPE_LABEL[v.type] || v.type,
}));
---
<BaseLayout>
  <Header active="reference" />
  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback="/reference/" label="Reference" />
    <h1 class="text-3xl mb-2 flex items-center gap-2">
      <Icon name="table" size={30} style="color: var(--color-bee)" />
      <span class="ref-title">
        <span>Verbtabellen</span>
        <span class="ref-title-en font-bold" style="color: var(--text-faint)">Verb tables</span>
      </span>
    </h1>
    <p class="mb-3" style="color:var(--text-muted)">
      Conjugation tables for {items.length} verbs: Präsens, Präteritum and Perfekt.
    </p>
    <p class="text-xs mb-8" style="color:var(--text-faint)">
      Learn the three principal forms as a triple: sprechen – sprach – gesprochen.
    </p>

    <RefSearch
      items={items}
      searchKeys={["inf", "en", "ich", "du", "er", "praet", "perf"]}
      levelFilter={false}
      placeholder="Search a verb… e.g. nehmen, to speak, ging"
      columns={[
        { key: "inf", label: "Infinitiv" },
        { key: "en", label: "English" },
        { key: "ich", label: "ich" },
        { key: "du", label: "du" },
        { key: "er", label: "er/sie/es" },
        { key: "praet", label: "Präteritum" },
        { key: "perf", label: "Perfekt" },
        { key: "typeLabel", label: "Type" },
      ]}
    />

    <RefGuide
      name="verbtabellen.md"
      title="Conjugation rules"
      intro="The principal forms, the endings behind every table, and the Konjunktiv II."
    />
  </main>
</BaseLayout>
