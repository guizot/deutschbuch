---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RefSearch from "../../components/RefSearch.astro";
import RefGuide from "../../components/RefGuide.astro";
import nouns from "../../data/nouns.json";
import "../../styles/global.css";
---
<BaseLayout>
  <Header active="reference" />
  <main class="max-w-4xl mx-auto px-4 py-10 pb-24">
    <a href="/reference/" class="text-sm font-bold mb-5 inline-block" style="color:var(--text-muted)"
      >← Reference</a
    >
    <h1 class="text-3xl mb-2">🔤 Nomen</h1>
    <p class="mb-3" style="color:var(--text-muted)">
      Nouns with article and plural. Filter by gender with the der / die / das buttons.
    </p>
    <p class="text-xs mb-8" style="color:var(--text-faint)">
      Plurals marked with an asterisk in the source were derived from rules, not verified
      dictionaries. Check dict.cc for anything exam-critical.
    </p>

    <RefSearch
      items={nouns}
      searchKeys={["de", "en", "stem", "plural"]}
      placeholder="Search nouns… e.g. Apfel, time, die Straße"
      articleFilter={true}
      columns={[
        { key: "de", label: "Nomen" },
        { key: "en", label: "English" },
        { key: "plural", label: "Plural" },
        { key: "level", label: "Level" },
      ]}
    />

    <RefGuide
      name="nomen.md"
      title="📘 Plural rules & study guide"
      intro="How German plurals work, the patterns worth memorising, and what the asterisks mean."
    />
  </main>
</BaseLayout>
