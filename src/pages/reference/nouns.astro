---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RefSearch from "../../components/RefSearch.astro";
import RefGuide from "../../components/RefGuide.astro";
import PageHeader from "../../components/PageHeader.astro";
import BackLink from "../../components/BackLink.astro";
import nouns from "../../data/nouns.json";
import "../../styles/global.css";
---
<BaseLayout>
  <Header active="reference" />
  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback="/reference/" label="Reference" />
    <PageHeader
      icon="letters"
      color="var(--color-macaw)"
      title="Nomen"
      en="Nouns"
      subtitle="Nouns with article and plural. Filter by gender with the der / die / das buttons."
      note="Plurals marked with an asterisk in the source were derived from rules, not verified dictionaries. Check dict.cc for anything exam-critical."
    />

    <RefSearch
      items={nouns}
      searchKeys={["de", "en", "stem", "plural"]}
      placeholder="Search nouns… e.g. Apfel, time, die Straße"
      articleFilter={true}
      columns={[
        { key: "de", label: "Nomen" },
        { key: "en", label: "English" },
        { key: "plural", label: "Plural" },
        { key: "level", label: "Level" },
      ]}
    />

    <RefGuide
      name="nomen.md"
      title="Plural rules & study guide"
      intro="How German plurals work, the patterns worth memorising, and what the asterisks mean."
    />
  </main>
</BaseLayout>
