---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RefSearch from "../../components/RefSearch.astro";
import RefGuide from "../../components/RefGuide.astro";
import PageHeader from "../../components/PageHeader.astro";
import BackLink from "../../components/BackLink.astro";
import phrases from "../../data/phrases.json";
import "../../styles/global.css";

// Normalise the level tag to a single CEFR bucket for filtering:
// "A2-B1" -> "A2", "B2-C1" -> "B2", "A1-A2" -> "A1"
const items = phrases.map((p) => ({
  ...p,
  level: (p.level.match(/A1|A2|B1|B2|C1/) || [""])[0],
  levelTag: p.level,
}));
---
<BaseLayout>
  <Header active="reference" />
  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback="/reference/" label="Reference" />
    <PageHeader
      icon="chat"
      color="var(--color-fox)"
      title="Redemittel"
      en="Phrase bank"
      subtitle={`${items.length} ready-made phrases for the writing and speaking exams. Learn 2–3 per function and make them yours.`}
    />

    <RefSearch
      items={items}
      searchKeys={["de", "en", "section", "part"]}
      placeholder="Search phrases… e.g. Meinung, Zwar, thank you"
      columns={[
        { key: "de", label: "Deutsch" },
        { key: "en", label: "English" },
        { key: "section", label: "Function" },
        { key: "levelTag", label: "Level" },
      ]}
    />

    <RefGuide
      name="redemittel.md"
      title="Exam guide & model texts"
      intro="How to use the phrase bank, plus full model letter and essay examples."
    />
  </main>
</BaseLayout>
