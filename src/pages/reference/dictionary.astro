---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RefSearch from "../../components/RefSearch.astro";
import RefGuide from "../../components/RefGuide.astro";
import Icon from "../../components/Icon.astro";
import BackLink from "../../components/BackLink.astro";
import dict from "../../data/dictionary.json";
import "../../styles/global.css";
---
<BaseLayout>
  <Header active="reference" />
  <main class="max-w-3xl mx-auto px-4 py-6 pb-24">
    <BackLink fallback="/reference/" label="Reference" />
    <h1 class="text-3xl mb-2 flex items-center gap-2">
      <Icon name="book" size={30} style="color: var(--color-feather)" />
      <span class="ref-title">
        <span>Wörterbuch</span>
        <span class="ref-title-en font-bold" style="color: var(--text-faint)">Dictionary</span>
      </span>
    </h1>
    <p class="mb-8" style="color:var(--text-muted)">
      Every word from the course, A–Z, with its level. Nouns keep their article.
    </p>

    <RefSearch
      items={dict}
      searchKeys={["de", "en", "extra"]}
      placeholder="Search German or English… e.g. Haus, to go, Dativ"
      columns={[
        { key: "de", label: "Deutsch" },
        { key: "en", label: "English" },
        { key: "extra", label: "Plural / Pattern" },
        { key: "level", label: "Level" },
      ]}
    />

    <RefGuide
      name="woerterbuch.md"
      title="How to use this dictionary"
      intro="What each column means and how the level tags work."
    />
  </main>
</BaseLayout>
